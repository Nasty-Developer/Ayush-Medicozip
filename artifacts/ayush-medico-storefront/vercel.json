{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/ayush-medico run build && tsc --project tsconfig.json",
  "outputDirectory": "dist/public",
  "builds": [
    {
      "src": "api/[...path].js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/[...path].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
