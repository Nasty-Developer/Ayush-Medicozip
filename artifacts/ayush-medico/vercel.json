{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/ayush-medico run build",
  "outputDirectory": "artifacts/ayush-medico/dist/public",
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
